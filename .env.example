# NyayaVedika — Environment Variables Template
# Copy this file to .env.local and fill in your values

# ======================
# Database (Supabase PostgreSQL + pgvector)
# ======================
DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres?schema=public"
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon-key]"
SUPABASE_SERVICE_ROLE_KEY="[service-role-key]"

# ======================
# Clerk Authentication
# ======================
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_dGhhbmtmdWwtamVubmV0LTkwMDMuY2xlcmsuYWNjb3VudHMuZGV2JA"
CLERK_SECRET_KEY="sk_test_[your-clerk-secret]"

# ======================
# AI Legal Reasoning (Gemini API)
# ======================
GEMINI_API_KEY="[your-gemini-api-key]"

# ======================
# Legacy / Local MySQL (Optional)
# ======================
DB_HOST="localhost"
DB_NAME="nyayavedika"
DB_USER="root"
DB_PASS=""

# ======================
# Email (Resend)
# ======================
RESEND_API_KEY="re_[your-resend-api-key]"
EMAIL_FROM="NyayaVedika <noreply@nyayavedika.in>"

# ======================
# Feature Flags
# ======================
ENABLE_AI_SEARCH="true"
ENABLE_OFFLINE="true"
ENABLE_PWA="true"
NODE_ENV="development"
NEXT_TELEMETRY_DISABLED="1"
