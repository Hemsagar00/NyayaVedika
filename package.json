{
  "name": "nyayavedik",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:push": "turbo run db:push --filter=@nyayavedik/db",
    "db:studio": "turbo run db:studio --filter=@nyayavedik/db",
    "db:generate": "turbo run db:generate --filter=@nyayavedik/db",
    "db:migrate": "turbo run db:migrate --filter=@nyayavedik/db"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.4.0",
  "engines": {
    "node": ">=20.0.0"
  }
}